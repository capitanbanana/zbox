{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#eff6ff",
    "primaryTextColor": "#172554",
    "primaryBorderColor": "#3b82f6",
    "lineColor": "#64748b",
    "secondaryColor": "#f0fdf4",
    "tertiaryColor": "#f8fafc",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#94a3b8",
    "edgeLabelBackground": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 28,
    "rankSpacing": 40
  },
  "sequence": {
    "useMaxWidth": false,
    "wrap": true,
    "actorMargin": 40,
    "messageMargin": 30,
    "noteMargin": 12,
    "mirrorActors": false
  },
  "htmlLabels": false
}
